# Environment Variables for VaidyaAI Backend
# Copy this to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/vaidyaai?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Server port (Render sets this automatically)
PORT=5000

# Frontend URL for CORS
FRONTEND_URL=https://vaidya-ai.onrender.com

# Google Cloud Agent Builder Configuration
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
AGENT_BUILDER_DATA_STORE_ID=your_data_store_id
AGENT_BUILDER_LOCATION=global
